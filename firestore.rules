rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Notre 11 type OL =====
    function joueurConnecte() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }
    // Profil + compos : tout le monde peut voir, seul le propriétaire peut modifier
    match /onzeol_users/{uid} {
      allow read: if joueurConnecte();
      allow write: if joueurConnecte() && request.auth.uid == uid;
    }
    // Drafts : seuls les 2 joueurs du draft peuvent le créer / le modifier
    match /onzeol_drafts/{key} {
      allow read: if joueurConnecte();
      allow create: if joueurConnecte() && request.auth.uid in request.resource.data.players;
      allow update: if joueurConnecte() && request.auth.uid in resource.data.players
                    && request.resource.data.players == resource.data.players;
      allow delete: if false;
    }
    // Échanges de cartes : créés par le proposeur, modifiables seulement par les 2 joueurs concernés
    match /onzeol_trades/{id} {
      allow read: if joueurConnecte();
      allow create: if joueurConnecte() && request.resource.data.from == request.auth.uid;
      allow update: if joueurConnecte() && request.auth.uid in [resource.data.from, resource.data.to]
                    && request.resource.data.from == resource.data.from && request.resource.data.to == resource.data.to
                    && request.resource.data.give == resource.data.give && request.resource.data.want == resource.data.want;
      allow delete: if false;
    }
    // Marché : le vendeur crée/retire ; un autre joueur peut seulement passer une annonce ouverte en « vendue » à son nom
    match /onzeol_market/{id} {
      allow read: if joueurConnecte();
      allow create: if joueurConnecte() && request.resource.data.seller == request.auth.uid && request.resource.data.status == 'open';
      allow update: if joueurConnecte()
        && request.resource.data.seller == resource.data.seller && request.resource.data.pid == resource.data.pid
        && ( (request.auth.uid == resource.data.seller && (resource.data.status == 'open' || request.resource.data.price == resource.data.price) && (resource.data.status != 'sold' || request.resource.data.status == 'sold'))
          || (request.auth.uid != resource.data.seller && request.resource.data.price == resource.data.price && resource.data.status == 'open' && request.resource.data.status == 'sold' && request.resource.data.buyer == request.auth.uid) );
      allow delete: if false;
    }
    // Enchères (doublons) : le vendeur crée/annule ; les autres ne peuvent que surenchérir à leur nom
    match /onzeol_auctions/{id} {
      allow read: if joueurConnecte();
      allow create: if joueurConnecte() && request.resource.data.seller == request.auth.uid && request.resource.data.bid == 0;
      allow update: if joueurConnecte()
        && request.resource.data.seller == resource.data.seller && request.resource.data.pid == resource.data.pid && request.resource.data.start == resource.data.start
        && ( (request.auth.uid == resource.data.seller && request.resource.data.bid == resource.data.bid && request.resource.data.bidder == resource.data.bidder)
          || (request.auth.uid != resource.data.seller && request.resource.data.bidder == request.auth.uid && request.resource.data.bid > resource.data.bid)
          || (request.auth.uid == resource.data.bidder && request.resource.data.bid == resource.data.bid && request.resource.data.bidder == resource.data.bidder) );
      allow delete: if false;
    }
    // Fil d'actu : chacun publie à son nom
    match /onzeol_feed/{id} {
      allow read: if joueurConnecte();
      allow create: if joueurConnecte() && request.resource.data.who == request.auth.uid;
      allow update, delete: if false;
    }
    // Championnats facultatifs : le créateur gère, les autres peuvent seulement se rajouter / se retirer
    match /onzeol_leagues/{id} {
      allow read: if joueurConnecte();
      allow create: if joueurConnecte() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];
      allow update: if joueurConnecte() && (resource.data.owner == request.auth.uid
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.toSet().difference(resource.data.members.toSet()).union(
                           resource.data.members.toSet().difference(request.resource.data.members.toSet()))
                           .hasOnly([request.auth.uid])));
      allow delete: if joueurConnecte() && resource.data.owner == request.auth.uid;
    }
    // Coupes à élimination : le créateur gère, inscription libre, les participants jouent leurs matchs
    match /onzeol_cups/{id} {
      allow read: if joueurConnecte();
      allow create: if joueurConnecte() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members == [request.auth.uid] && request.resource.data.status == 'open';
      allow update: if joueurConnecte() && (resource.data.owner == request.auth.uid
                    || (resource.data.status == 'open'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.toSet().difference(resource.data.members.toSet()).union(
                           resource.data.members.toSet().difference(request.resource.data.members.toSet()))
                           .hasOnly([request.auth.uid]))
                    || (resource.data.status == 'running' && request.auth.uid in resource.data.members
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rounds','status','winner','finalist'])));
      allow delete: if joueurConnecte() && resource.data.owner == request.auth.uid;
    }
    // Match en direct + historique : n'importe quel joueur connecté
    match /onzeol_meta/{doc} {
      allow read, write: if joueurConnecte();
    }
  }
}
